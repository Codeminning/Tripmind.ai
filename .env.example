# Copy this file to .env and add your own API key.
# Keep this key private; never put it in src/ or a VITE_ variable.
GEMINI_API_KEY=your_api_key_here
PORT=3001
DATABASE_URL=postgresql://neondb_owner:your_password@ep-something.neon.tech/neondb?sslmode=require
JWT_SECRET=your_jwt_secret_here
RESEND_API_KEY=

# Google Calendar Direct Sync (OAuth 2.0 Web Application credentials from Google Cloud Console)
# If left blank, TripMind gracefully provides the 1-Click Google Calendar Web Intent button
# and universal .ics calendar export!
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback


